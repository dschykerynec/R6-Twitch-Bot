# Copy this file to .env and fill in your own values.
# .env is gitignored — nothing in it is ever committed.

# R6 stats API (https://r6.arenyze.com) — register an account to get a key.
R6DATA_API_KEY=

# The R6 username shown by default for bare "!rank" / "!legend" (no name given).
# Required — there's no code-level fallback, so bare commands break without it.
# Change this to clone the bot for a different streamer/player.
DEFAULT_PLAYER=player_name

# Twitch app credentials (https://dev.twitch.tv/console/apps).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch OAuth tokens for the bot account (needs chat:read + user:write:chat scopes).
TWITCH_OAUTH_TOKEN=
TWITCH_REFRESH_TOKEN=

# Twitch user IDs (https://streamscharts.com/tools/convert-username — or the Twitch API)
TWITCH_BOT_USER_ID=
TWITCH_CHANNEL_USER_ID=
